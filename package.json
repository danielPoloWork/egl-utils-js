{
  "name": "egl-utils-js",
  "version": "0.9.0",
  "description": "Universal JavaScript async, data, and event utilities for Node.js and modern browsers",
  "keywords": [
    "utilities",
    "async",
    "abort-signal",
    "events",
    "tree-shakeable",
    "esm",
    "cjs"
  ],
  "license": "MIT",
  "author": "Daniel Polo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielPoloWork/egl-utils-js.git"
  },
  "bugs": {
    "url": "https://github.com/danielPoloWork/egl-utils-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "sideEffects": false,
  "files": [
    "dist",
    "src/main/javascript/it/d4np/utils/webcrypto-node.js",
    "src/main/javascript/it/d4np/utils/webcrypto-browser.js"
  ],
  "imports": {
    "#webcrypto": {
      "node": "./src/main/javascript/it/d4np/utils/webcrypto-node.js",
      "default": "./src/main/javascript/it/d4np/utils/webcrypto-browser.js"
    }
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node/esm/index.d.ts",
          "default": "./dist/node/esm/index.js"
        },
        "require": {
          "types": "./dist/node/cjs/index.d.cts",
          "default": "./dist/node/cjs/index.cjs"
        }
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/esm/storage.d.ts",
        "default": "./dist/esm/storage.js"
      },
      "require": {
        "types": "./dist/cjs/storage.d.cts",
        "default": "./dist/cjs/storage.cjs"
      }
    },
    "./sanitize": {
      "import": {
        "types": "./dist/esm/sanitize.d.ts",
        "default": "./dist/esm/sanitize.js"
      },
      "require": {
        "types": "./dist/cjs/sanitize.d.cts",
        "default": "./dist/cjs/sanitize.cjs"
      }
    },
    "./text": {
      "import": {
        "types": "./dist/esm/text.d.ts",
        "default": "./dist/esm/text.js"
      },
      "require": {
        "types": "./dist/cjs/text.d.cts",
        "default": "./dist/cjs/text.cjs"
      }
    },
    "./table": {
      "import": {
        "types": "./dist/esm/table.d.ts",
        "default": "./dist/esm/table.js"
      },
      "require": {
        "types": "./dist/cjs/table.d.cts",
        "default": "./dist/cjs/table.cjs"
      }
    },
    "./net": {
      "import": {
        "types": "./dist/esm/net.d.ts",
        "default": "./dist/esm/net.js"
      },
      "require": {
        "types": "./dist/cjs/net.d.cts",
        "default": "./dist/cjs/net.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/esm/dom.d.ts",
        "default": "./dist/esm/dom.js"
      },
      "require": {
        "types": "./dist/cjs/dom.d.cts",
        "default": "./dist/cjs/dom.cjs"
      }
    },
    "./bootstrap": {
      "import": {
        "types": "./dist/esm/bootstrap.d.ts",
        "default": "./dist/esm/bootstrap.js"
      },
      "require": {
        "types": "./dist/cjs/bootstrap.d.cts",
        "default": "./dist/cjs/bootstrap.cjs"
      }
    },
    "./logging": {
      "import": {
        "types": "./dist/esm/logging.d.ts",
        "default": "./dist/esm/logging.js"
      },
      "require": {
        "types": "./dist/cjs/logging.d.cts",
        "default": "./dist/cjs/logging.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/esm/errors.d.ts",
        "default": "./dist/esm/errors.js"
      },
      "require": {
        "types": "./dist/cjs/errors.d.cts",
        "default": "./dist/cjs/errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:redos": "vitest run --coverage.enabled=false src/test/javascript/it/d4np/utils/validate-email.redos.test.js",
    "coverage": "vitest run --coverage --exclude \"**/*.redos.test.js\"",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "docs:api": "typedoc",
    "size": "size-limit",
    "check:publint": "publint --strict",
    "check:exports": "attw --pack . --profile node16",
    "check:deps": "node tools/assert-no-runtime-deps.mjs",
    "check:shakeable": "agadoo dist/esm/index.js",
    "check:package": "pnpm build && pnpm check:publint && pnpm check:exports && pnpm size && pnpm check:shakeable && pnpm check:deps",
    "audit": "pnpm audit --audit-level moderate",
    "changeset": "changeset",
    "changeset:version": "changeset version && node tools/sync-version.mjs && pnpm install --lockfile-only",
    "changeset:status": "changeset status --since=origin/main",
    "bench": "vitest bench --run",
    "bench:check": "node tools/bench-regression.mjs",
    "bench:baseline": "node tools/bench-regression.mjs --update",
    "check:version": "node tools/sync-version.mjs --check",
    "check:api-floor": "node tools/check-api-floor.mjs"
  },
  "peerDependencies": {
    "bootstrap": "^5",
    "dompurify": "^3.4.13"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@mdn/browser-compat-data": "^8.0.8",
    "@playwright/test": "^1.62.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "agadoo": "^3.0.0",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.13",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "lodash": "4.18.1",
    "p-limit": "6.2.0",
    "p-retry": "6.2.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": []
    },
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "postcss@<8.5.23": ">=8.5.23",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "nanoid@<3.3.17": "~3.3.17",
      "js-yaml@>=3.0.0 <3.15.1": "~3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "~4.3.1"
    }
  },
  "browserslist": [
    "safari >= 16.4",
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 edge versions"
  ]
}
